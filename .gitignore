# ──────────────────────────────────────────
#  Yogesh Portfolio — .gitignore
# ──────────────────────────────────────────

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp.*

# ── Environment & Secrets (NEVER commit these) ──
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# ── IBM Credentials (extra safety net) ──
ibm-credentials.env
credentials.json
service_credentials.json
watsonx_credentials.json

# ── OS files ──
.DS_Store
._*
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE / Editor ──
.vscode/
.idea/
*.suo
*.sw?
*.swp
*~

# ── Logs ──
logs/
*.log
pids/
*.pid

# ── Build / Cache ──
dist/
build/
.cache/
.temp/
tmp/

# ── Coverage ──
coverage/
.nyc_output/

# ── Package lock (keep package-lock.json) ──
yarn.lock

# ── Misc ──
*.tgz
*.zip
*.tar.gz

# IBM Cloud API key file (credentials — never commit)
apikey.json
*apikey*.json
*credentials*.json
