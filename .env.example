# ──────────────────────────────────────────────────────────────────────────────
#  Yogesh Portfolio — .env.example
#  Copy this file to .env and fill in your real values.
#  The .env file is gitignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# IBM Cloud API Key (required for IBM Granite AI)
# Get from: https://cloud.ibm.com → Manage → Access → API Keys
IBM_API_KEY=YOUR_IBM_API_KEY_HERE

# IBM watsonx.ai Project ID (required for IBM Granite AI)
# Get from: https://dataplatform.cloud.ibm.com → your project → Settings
IBM_PROJECT_ID=YOUR_IBM_PROJECT_ID_HERE

# IBM Region (optional — default: us-south)
# Options: us-south | eu-de | eu-gb | jp-tok | au-syd
IBM_REGION=us-south

# Server Port (optional — default: 3000)
PORT=3000
